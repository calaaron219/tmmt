# ─── Database (Railway Postgres or Neon) ─────────────────
# Copy from Railway → Postgres service → Variables tab
DATABASE_URL="postgresql://user:password@host:5432/tmmt?schema=public"

# ─── Redis (BullMQ worker — Phase 4+) ────────────────────
# Local:   brew install redis && brew services start redis  →  redis://localhost:6379
# Railway: on the api service set  REDIS_URL=${{Redis.REDIS_URL}}  (internal host)
REDIS_URL="redis://localhost:6379"

# ─── Auth.js (Phase 1) ───────────────────────────────────
# AUTH_SECRET: generate with `openssl rand -base64 32`
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# AUTH_URL: base URL of your deployed web app (production only)
# Locally Next.js auto-detects; in Vercel set to your Vercel URL.
# AUTH_URL="https://your-app.vercel.app"

# GitHub OAuth — https://github.com/settings/developers
# Authorization callback URL: {AUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Google Gemini (Phase 2+) ────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# ─── App ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
NODE_ENV="development"
